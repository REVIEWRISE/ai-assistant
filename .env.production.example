# Template for .env.production — copy to .env.production and fill in real values.
# Never commit the filled-in file (see .gitignore: .env* is ignored, this .example is allowlisted).

# --- Database ---
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_assistant
DATABASE_URL=postgresql://ai_user:change_me@postgres:5432/ai_assistant

# --- App ---
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Seed admin (first-time setup only) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me
SEED_ADMIN_NAME=Admin

# --- OAuth token / secrets-at-rest encryption (SOC 2 CC6.1) ---
# Required in production — the app refuses to start without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Health check endpoint (SOC 2 CC6.6) ---
# Required in production so /api/health doesn't leak internal DB/schema details externally.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HEALTH_CHECK_TOKEN=

# --- Sentry error tracking (optional — safe no-op if left unset) ---
# Sign up at sentry.io, create a Next.js project, copy the DSN. IMPORTANT: for
# the browser-side DSN to actually take effect, this must be set as the
# SENTRY_DSN GitHub secret (build-time) — adding it only here, after the image
# is already built, is too late for the client bundle. See DEPLOYMENT.md.
NEXT_PUBLIC_SENTRY_DSN=

# --- OpenAI (chatbot replies, custom LLM voice calls) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Retell AI (voice support) ---
RETELL_API_KEY=your_retell_api_key
RETELL_USE_CUSTOM_LLM=true
RETELL_CUSTOM_LLM_PORT=3001
# Optional override; defaults to wss://your-domain.com/llm-websocket when nginx proxies /llm-websocket -> :3017
# RETELL_CUSTOM_LLM_WS_URL=wss://your-domain.com/llm-websocket

# --- SMTP (booking confirmation emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-google-app-password
BOOKING_EMAIL_FROM=VyntRise Bookings <you@gmail.com>
BOOKING_NOTIFY_EMAIL=you@gmail.com

# --- Vyntrise Billing microservice ---
BILLING_API_URL=https://billing.vyntrise.com/api/v1
BILLING_API_KEY=vbk_live_...
BILLING_PRODUCT_NAME=agents
BILLING_ADMIN_URL=https://billing.vyntrise.com
VYNTRISE_WEBHOOK_SECRET=whsec_vbk_...
APP_URL=https://your-domain.com
