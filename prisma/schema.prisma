generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  accountStatus String   @default("active") @map("account_status")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  organizationMembers OrganizationMember[]
  memberMenuAccesses  OrganizationMemberMenuAccess[]
  userRoles           UserRole[]
  auditEvents         AuditEvent[]
  providerConnections ProviderConnection[]
  routedChatbotAppointments Appointment[] @relation("AppointmentRoutedUser")

  @@map("users")
}

model Session {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  token                String   @unique
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@map("sessions")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  logoUrl   String?  @map("logo_url")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  planSlug             String?   @map("plan_slug")
  billingStatus        String    @default("needs_plan") @map("billing_status")
  billingInterval      String?   @map("billing_interval")
  trialStartsAt        DateTime? @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt          DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  currentPeriodEndsAt  DateTime? @map("current_period_ends_at") @db.Timestamptz(6)

  members        OrganizationMember[]
  memberMenuAccesses OrganizationMemberMenuAccess[]
  reviewServices ReviewService[]
  reviews        Review[]
  appointments   Appointment[]
  leads          Lead[]
  auditEvents    AuditEvent[]
  activeSessions Session[]
  knowledgeBase  OrganizationKnowledgeBase?
  chatbotSettings OrganizationChatbotSettings?
  reviewSettings OrganizationReviewSettings?
  voiceAgentSettings OrganizationVoiceAgentSettings?
  retellCalls    RetellCall[]
  retellPhoneNumbers RetellPhoneNumber[]

  @@map("organizations")
}

model OrganizationReviewSettings {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  routingRules   Json     @default(dbgenerated("'{}'::jsonb")) @map("routing_rules") @db.JsonB
  syncCron       Json     @default(dbgenerated("'{}'::jsonb")) @map("sync_cron") @db.JsonB
  replyAutomation Json    @default(dbgenerated("'{}'::jsonb")) @map("reply_automation") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_review_settings")
}

model OrganizationVoiceAgentSettings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  retellConfig    Json     @default(dbgenerated("'{}'::jsonb")) @map("retell_config") @db.JsonB
  phoneConfig     Json     @default(dbgenerated("'{}'::jsonb")) @map("phone_config") @db.JsonB
  knowledgeConfig Json     @default(dbgenerated("'{}'::jsonb")) @map("knowledge_config") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_voice_agent_settings")
}

model RetellCall {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId          String   @unique @map("call_id")
  organizationId  String   @map("organization_id") @db.Uuid
  agentId         String   @map("agent_id")
  callStatus      String   @map("call_status")
  direction       String
  fromNumber      String?  @map("from_number")
  toNumber        String?  @map("to_number")
  durationSeconds Int      @map("duration_seconds")
  cost            Decimal  @db.Decimal(10, 4)
  recordingUrl    String?  @map("recording_url")
  summary         String?  @db.Text
  sentiment       String?
  transcript      Json     @default(dbgenerated("'[]'::jsonb")) @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("retell_calls")
}

model RetellPhoneNumber {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  phoneNumber       String   @map("phone_number")
  phoneNumberPretty String?  @map("phone_number_pretty")
  nickname          String?
  retellAgentId     String?  @map("retell_agent_id")
  phoneNumberType   String?  @map("phone_number_type")
  areaCode          Int?     @map("area_code")
  isPrimary         Boolean  @default(false) @map("is_primary")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phoneNumber])
  @@map("retell_phone_numbers")
}

model OrganizationChatbotSettings {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  welcomeMessage String   @default("") @map("welcome_message")
  ctaLabel       String   @default("Continue to secure booking") @map("cta_label")
  themeColor     String   @default("#22c55e") @map("theme_color")
  iconColor      String   @default("#0f172a") @map("icon_color")
  services         Json     @default(dbgenerated("'[]'::jsonb")) @map("services") @db.JsonB
  bookingFlow      Json     @default(dbgenerated("'{}'::jsonb")) @map("booking_flow") @db.JsonB
  crmIntegration   Json     @default(dbgenerated("'{}'::jsonb")) @map("crm_integration") @db.JsonB
  voiceBooking     Json     @default(dbgenerated("'{}'::jsonb")) @map("voice_booking") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_chatbot_settings")
}

model OrganizationKnowledgeBase {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  sourceType     String   @default("text") @map("source_type")
  sourceUrl      String?  @map("source_url")
  sourceFileName String?  @map("source_file_name")
  status         String   @default("draft")
  rawText        String   @default("") @map("raw_text")
  parsedData     Json?    @map("parsed_data") @db.JsonB
  lastImportedAt DateTime? @map("last_imported_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_knowledge_bases")
}

model OrganizationMember {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  role            String   @default("member")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model ReviewService {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  provider       String
  status         String   @default("not_connected")
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("review_services")
}

model Review {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  provider         String
  externalReviewId String?  @map("external_review_id")
  rating           Int
  reviewText       String   @map("review_text")
  responseText     String?  @map("response_text")
  status           String   @default("pending")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Appointment {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  customerName             String   @map("customer_name")
  customerEmail            String?  @map("customer_email")
  startTime                DateTime @map("start_time") @db.Timestamptz(6)
  endTime                  DateTime @map("end_time") @db.Timestamptz(6)
  status                   String   @default("requested")
  source                   String   @default("web")
  serviceDescription       String?  @map("service_description")
  partySize                Int?     @map("party_size")
  /// Guided chatbot steps at save time: [{ question, answer }, ...]
  bookingFlowQa            Json?    @map("booking_flow_qa")
  rawMessage               String?  @map("raw_message")
  routedProviderId           String?  @map("routed_provider_id") @db.Uuid
  routedConnectionUserId     String?  @map("routed_connection_user_id") @db.Uuid
  providerSyncStatus         String   @default("pending") @map("provider_sync_status")
  externalCalendarEventId    String?  @map("external_calendar_event_id")
  providerSyncError          String?  @map("provider_sync_error")
  crmSyncStatus              String   @default("not_applicable") @map("crm_sync_status")
  crmSyncError               String?  @map("crm_sync_error")
  crmSyncAttempts            Int      @default(0) @map("crm_sync_attempts")
  retellCallId               String?  @map("retell_call_id")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routedProvider         Provider?    @relation(fields: [routedProviderId], references: [id], onDelete: SetNull)
  routedConnectionUser   User?        @relation("AppointmentRoutedUser", fields: [routedConnectionUserId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

model Lead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String?
  email          String?
  source         String   @default("web")
  status         String   @default("new")
  score          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  metadata       Json     @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_events")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles UserRole[]
  menuAccesses MenuAccess[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model MenuItem {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  description String?
  label     String
  path      String
  icon      String?
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  parent   MenuItem?  @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemHierarchy")
  menuAccess  MenuAccess[]
  memberMenuAccesses OrganizationMemberMenuAccess[]

  @@map("menu_items")
}

model OrganizationMemberMenuAccess {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  menuItemId     String   @map("menu_item_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, menuItemId])
  @@map("organization_member_menu_access")
}

model MenuAccess {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, roleId])
  @@map("menu_access")
}

model Provider {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  type        String   @default("review")
  apiUrl      String?  @map("api_url")
  logoUrl     String?  @map("logo_url")
  status      String   @default("enabled")
  config      Json?    @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  connections         ProviderConnection[]
  routedAppointments Appointment[]

  @@map("providers")
}

model ProviderConnection {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  connected  Boolean  @default(false)
  tokenData  Json?    @map("token_data") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("provider_connections")
}

model BillingWebhookEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @unique @map("event_id")
  eventType      String   @map("event_type")
  organizationId String?  @map("organization_id") @db.Uuid
  productId      String?  @map("product_id")
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  payload        Json     @default(dbgenerated("'{}'::jsonb")) @db.JsonB

  @@index([organizationId])
  @@map("billing_webhook_events")
}
