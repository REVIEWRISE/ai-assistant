{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "db:create": "tsx scripts/db-create.ts",
    "db:migrate": "prisma db push && prisma generate",
    "postinstall": "prisma generate",
    "db:sync": "sh scripts/db-sync.sh",
    "db:seed": "prisma db seed",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "seed:billing-modules": "tsx scripts/seed-billing-modules.ts",
    "seed:billing-starter": "tsx scripts/seed-billing-modules.ts --only=starter",
    "seed:billing-growth": "tsx scripts/seed-billing-modules.ts --only=growth",
    "seed:billing-pro-voice": "tsx scripts/seed-billing-modules.ts --only=pro_voice",
    "cleanup:legacy-plan-modules": "tsx scripts/cleanup-legacy-plan-modules.ts",
    "cron:review-sync": "tsx scripts/review-sync-cron.ts",
    "retell:llm": "tsx scripts/retell-custom-llm-server.ts",
    "retell:migrate": "tsx scripts/migrate-retell-to-custom-llm.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "bcryptjs": "^3.0.3",
    "next": "16.1.6",
    "nodemailer": "^8.0.8",
    "pg": "^8.20.0",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tsx": "^4.23.12",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
