# Stage 1: Dependencies
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate
ENV NEXT_TELEMETRY_DISABLED 1
RUN npm run build

# Bundle TS scripts for production runtime
RUN npx esbuild scripts/retell-custom-llm-server.ts --bundle --platform=node --target=node20 --outfile=dist/retell-custom-llm-server.js --external:prisma --external:@prisma/client
RUN npx esbuild scripts/migrate-retell-to-custom-llm.ts --bundle --platform=node --target=node20 --outfile=dist/migrate-retell-to-custom-llm.js --external:prisma --external:@prisma/client
RUN npx esbuild scripts/review-sync-cron.ts --bundle --platform=node --target=node20 --outfile=dist/review-sync-cron.js --external:prisma --external:@prisma/client

# Stage 3: Production-only Dependencies
FROM node:20-alpine AS prod-deps
WORKDIR /app
COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci --omit=dev
RUN npx prisma generate

# Stage 4: Runner
FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache curl

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
RUN mkdir -p /app/public/uploads/providers /app/public/uploads/organizations && chown -R nextjs:nodejs /app/public/uploads
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/scripts/db-sync.sh ./scripts/db-sync.sh
COPY --from=builder /app/scripts/ensure-menus.cjs ./scripts/ensure-menus.cjs
COPY --from=builder /app/dist ./dist

# Copy production dependencies and generated Prisma client
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/src/generated/prisma ./src/generated/prisma
RUN chmod +x ./scripts/db-sync.sh

# Automatically leverage output traces to reduce image size
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Fix ownership so nextjs user can read node_modules
RUN chown -R nextjs:nodejs /app/node_modules

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["node", "server.js"]

